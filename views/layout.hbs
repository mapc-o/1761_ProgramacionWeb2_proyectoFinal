<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="initial-scale=1, width=device-width">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="icon" type="image/x-icon" href="images/favicon.ico">

  <title>Atay 'Avii: {{title}}</title>
</head>
<body class="bg-dark text-light">
  <nav class="navbar navbar-expand-md navbar-dark bg-dark border-bottom border-light">
    <div class="container-fluid">
      <a class="navbar-brand fw-bold text-success" href="/home">
        ATAY'AVII: Mercado de Acciones
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbar">
        {{#if user_id}}
          <ul class="navbar-nav me-auto mt-2">
            <li class="nav-item"><a class="nav-link" href="/consultar">Consultar</a></li>
            <li class="nav-item"><a class="nav-link" href="/comprar">Comprar</a></li>
            <li class="nav-item"><a class="nav-link" href="/vender">Vender</a></li>
            <li class="nav-item"><a class="nav-link" href="/historial">Historial</a></li>
          </ul>
          <ul class="navbar-nav ms-auto mt-2">
            <li class="nav-item me-3">
              <span class="badge bg-success fs-6">Saldo: ${{saldo}}</span>
            </li>
            <li class="nav-item"><a class="nav-link text-danger" href="/logout">Cerrar Sesión</a></li>
          </ul>
        {{else}}
          <ul class="navbar-nav ms-auto mt-2">
            <li class="nav-item mx-2">
              <a class="btn btn-outline-success" href="/signup">Crear Cuenta</a>
            </li>
            <li class="nav-item mx-2">
              <a class="btn btn-success" href="/login">Inicia Sesión</a>
            </li>
          </ul>
        {{/if}}
      </div>
    </div>
  </nav>


  <main class="container py-5 text-center">
    {{{body}}}
  </main>

  <script type="text/javascript" src="/javascripts/index.js"></script>
</body>
</html>