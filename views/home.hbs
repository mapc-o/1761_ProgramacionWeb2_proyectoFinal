<title>Inicio</title>

<h1 class="text-light">Portafolio</h1>
<table class="table table-dark table-striped table-hover align-middle">
  <thead>
    <tr>
      <th>Symbol</th>
      <th>Shares</th>
      <th>Price</th>
      <th>Total</th>
    </tr>
  </thead>
  <tbody>
    {{#each stocks}}
      <tr>
        <td>{{symbol}}</td>
        <td>{{shares}}</td>
        <td>{{price}}</td>
        <td>{{total}}</td>
      </tr>
    {{/each}}
  </tbody>
</table>

{{#if nuevo_user}}
<div class="toast-container position-fixed bottom-0 end-0 p-3">
  <div id="welcomeToast" class="toast bg-success text-white" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="toast-header bg-success text-white">
      <strong class="me-auto">¡Bienvenido!</strong>
      <button type="button" class="btn-close btn-close-white ms-2 mb-1" data-bs-dismiss="toast" aria-label="Cerrar"></button>
    </div>
    <div class="toast-body">
      Te hemos depositado dinero extra por ser de nuestros primeros clientes
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toastEl = document.getElementById('welcomeToast');
    if (toastEl) {
      new bootstrap.Toast(toastEl, { delay: 5000 }).show();
    }
  });
</script>
{{/if}}


<button id="btn" class="btn btn-warning d-none" data-bs-toggle="modal" data-bs-target="#container">Quiz</button>

<div class="modal fade" id="container" tabindex="-1" aria-labelledby="quizLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark text-light">
      <div class="modal-header">
        <h5 class="modal-title text-success" id="quizLabel">Obtén saldo extra</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <p id="pregunta" class="fw-bold mb-3"></p>
        <p>Arrastra el ticker correcto hacia la caja para incrementar tu saldo:</p>

        <div id="opciones" class="d-flex justify-content-around mb-3">
          <div id="drag_AAPL" class="badge bg-primary p-3" draggable="true">AAPL</div>
          <div id="drag_MSFT" class="badge bg-success p-3" draggable="true">MSFT</div>
          <div id="drag_GOOGL" class="badge bg-danger p-3" draggable="true">GOOGL</div>
          <div id="drag_TSLA" class="badge bg-warning p-3" draggable="true">TSLA</div>
          <div id="drag_MCD" class="badge bg-info p-3" draggable="true">MCD</div>
        </div>

        <div id="drop_zone" class="border border-light p-5 text-center">
          <p>Suelta aquí tu respuesta</p>
        </div>

        <div id="resultado" class="mt-3">

        </div>
      </div>
    </div>
  </div>
</div>

<a href="/users" 
   class="btn btn-secondary position-fixed bottom-0 end-0 m-3">
  Ver usuarios y transacciones
</a>

<script src="/javascripts/extraCash.js"></script>


