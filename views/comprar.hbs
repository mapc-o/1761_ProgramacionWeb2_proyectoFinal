<div class="d-flex justify-content-center">
  <form action="/comprar" method="post" class="bg-dark text-light p-4 rounded shadow w-50">

    <h2 class="mb-4 text-success text-center">Comprar acciones</h2>

    <div class="mb-3">
      <label for="symbol" class="form-label">Ticker</label>
      <input type="text" class="form-control bg-secondary text-light border-0" id="symbol" name="symbol" placeholder="Ingresa un ticker">
    </div>

    <div class="mb-3">
      <label for="shares" class="form-label">Cantidad de acciones</label>
      <input type="number" class="form-control bg-secondary text-light border-0" id="shares" name="shares" placeholder="Ingresa la cantidad" autocomplete="off">
    </div>

    <button type="submit" class="btn btn-success w-100 fw-bold">
      Comprar
    </button>

    {{#if error}}
      <div class="alert alert-danger mt-3" role="alert">
        {{error}}
      </div>
    {{/if}}


  </form>
</div>

{{#if success}}
  <div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3">
    <div id="transaction_toast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body">
          {{success}}
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
      </div>
    </div>
  </div>
{{/if}}



