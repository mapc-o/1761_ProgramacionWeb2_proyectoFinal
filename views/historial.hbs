<title>Historial</title>

<h1 class="text-light">Historial de operaciones</h1>
    <table class="table table-dark table-striped table-hover align-middle">
      <thead>
        <tr>
          <th>Fecha</th>
          <th>Acción</th>
          <th>Símbolo</th>
          <th>Acciones</th>
          <th>Precio</th>
        </tr>
      </thead>
      <tbody>
        {{#each transactions}}
          <tr class="transaction-row {{type}}">
            <td>{{date}}</td>
            <td>{{type}}</td>
            <td>{{symbol}}</td>
            <td>{{shares}}</td>
            <td>{{price}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>